# Copy to `.env` and replace the placeholder values with real secrets.
POSTGRES_USER=pentest
POSTGRES_PASSWORD=change-me-with-a-long-random-password
POSTGRES_DB=subnex

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The backend refuses to start while this is a placeholder or shorter than 16 chars.
JWT_SECRET=change-me-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60